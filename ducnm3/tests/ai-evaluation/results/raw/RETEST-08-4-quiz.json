  {
   "id": "4d5e2bb4-303d-40f9-9e93-60962ddd5493",
   "questionMarkdown": "Gọi $m_i$ là tần số của lớp có giá trị đại diện $c_i$ và $n$ là tổng cỡ mẫu. Công thức trung bình $\\\\bar{x}$ của mẫu ghép nhóm là:",
   "questionHtml": "<p>Gọi <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"m_i\"></span> là tần số của lớp có giá trị đại diện <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i\"></span> và <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"n\"></span> là tổng cỡ mẫu. Công thức trung bình <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"\\\\bar{x}\"></span> của mẫu ghép nhóm là:</p>\n",
   "questionType": "SINGLE_CHOICE",
   "points": 1.0,
   "displayOrder": 2,
   "options": [
    {
     "id": "066e508e-2e27-4815-b98b-d5f4f75adc35",
     "optionMarkdown": "$\\\\bar{x}=\\\\dfrac{m_1+m_2+\\\\cdots+m_k}{n}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"\\\\bar{x}=\\\\dfrac{m_1&#x2B;m_2&#x2B;\\\\cdots&#x2B;m_k}{n}\"></span></p>\n",
     "isCorrect": false,
     "displayOrder": 1
    },
    {
