                  "pm.test(\"Created\", function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "pm.test(\"Usage references media\", function () {",
                  "  pm.expect(payload.data.mediaId).to.eql(pm.collectionVariables.get(\"mediaId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
