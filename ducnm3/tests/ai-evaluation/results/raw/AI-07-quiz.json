     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"\\bar{x} = \\dfrac{c_1 &#x2B; c_2 &#x2B; \\dots &#x2B; c_k}{n}\"></span></p>\n",
