     "optionMarkdown": "$\\\\bar{x}=\\\\dfrac{m_1 c_1+m_2 c_2+\\\\cdots+m_k c_k}{n}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"\\\\bar{x}=\\\\dfrac{m_1 c_1&#x2B;m_2 c_2&#x2B;\\\\cdots&#x2B;m_k c_k}{n}\"></span></p>\n",
     "isCorrect": true,
     "displayOrder": 2
    },
    {
     "id": "b1c5dc50-5f79-426e-90e0-47c4ecec6975",
     "optionMarkdown": "$\\\\bar{x}=\\\\dfrac{c_1+c_2+\\\\cdots+c_k}{n}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"\\\\bar{x}=\\\\dfrac{c_1&#x2B;c_2&#x2B;\\\\cdots&#x2B;c_k}{n}\"></span></p>\n",
     "isCorrect": false,
     "displayOrder": 3
    },
    {
     "id": "e15a85f1-3dff-45c4-9edf-7ec8abc058ed",
     "optionMarkdown": "$\\\\bar{x}=c_j$ với $m_j$ lớn nhất",
