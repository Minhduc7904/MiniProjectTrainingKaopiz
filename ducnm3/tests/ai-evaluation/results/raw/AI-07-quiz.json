     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"M_e = a_{p&#x2B;1} - \\dfrac{\\left(\\frac{n}{2} - (m_1&#x2B;\\dots&#x2B;m_{p-1})\\right)}{m_p}(a_{p&#x2B;1}-a_p)\"></span></p>\n",
