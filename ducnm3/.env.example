ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Swagger__Enabled=true

MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
COURSE_DB_NAME=lms_course_db
COURSE_DB_USER=replace-with-course-db-user
COURSE_DB_PASSWORD=replace-with-a-local-course-password
STUDENT_DB_NAME=lms_student_db
STUDENT_DB_USER=replace-with-student-db-user
STUDENT_DB_PASSWORD=replace-with-a-local-student-password
MEDIA_DB_NAME=lms_media_db
MEDIA_DB_USER=replace-with-media-db-user
MEDIA_DB_PASSWORD=replace-with-a-local-media-password
NOTIFICATION_DB_NAME=lms_notification_db
NOTIFICATION_DB_USER=replace-with-notification-db-user
NOTIFICATION_DB_PASSWORD=replace-with-a-local-notification-password
SCHEDULER_DB_NAME=lms_scheduler_db
SCHEDULER_DB_USER=replace-with-scheduler-db-user
SCHEDULER_DB_PASSWORD=replace-with-a-local-scheduler-password

MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-root-password
MINIO_APP_ACCESS_KEY=replace-with-media-storage-access-key
MINIO_APP_SECRET_KEY=replace-with-a-long-media-storage-secret
MINIO_USE_SSL=false
MINIO_HEALTH_TIMEOUT_SECONDS=3
MINIO_IMAGE_BUCKET=images
MINIO_VIDEO_BUCKET=videos
MINIO_DOCUMENT_BUCKET=documents
MINIO_AUDIO_BUCKET=audios
MINIO_OTHER_BUCKET=other

COURSE_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_course_db;User ID=replace-with-course-db-user;Password=replace-with-a-local-course-password;SslMode=None;AllowPublicKeyRetrieval=True"
STUDENT_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_student_db;User ID=replace-with-student-db-user;Password=replace-with-a-local-student-password;SslMode=None;AllowPublicKeyRetrieval=True"
MEDIA_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_media_db;User ID=replace-with-media-db-user;Password=replace-with-a-local-media-password;SslMode=None;AllowPublicKeyRetrieval=True"
NOTIFICATION_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_notification_db;User ID=replace-with-notification-db-user;Password=replace-with-a-local-notification-password;SslMode=None;AllowPublicKeyRetrieval=True"
SCHEDULER_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_scheduler_db;User ID=replace-with-scheduler-db-user;Password=replace-with-a-local-scheduler-password;SslMode=None;AllowPublicKeyRetrieval=True"

COURSE_DB_LOCAL_CONNECTION_STRING="Server=localhost;Port=3306;Database=lms_course_db;User ID=replace-with-course-db-user;Password=replace-with-a-local-course-password;SslMode=None;AllowPublicKeyRetrieval=True"
STUDENT_DB_LOCAL_CONNECTION_STRING="Server=localhost;Port=3306;Database=lms_student_db;User ID=replace-with-student-db-user;Password=replace-with-a-local-student-password;SslMode=None;AllowPublicKeyRetrieval=True"
