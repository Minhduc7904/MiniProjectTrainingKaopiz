  {
   "id": "32fb5580-b923-4592-a3e0-e374188bc31c",
   "questionMarkdown": "Trong mẫu số liệu ghép nhóm, mỗi lớp có dạng $[a_i; a_{i+1})$. Giá trị đại diện $c_i$ được tính như thế nào?",
   "questionHtml": "<p>Trong mẫu số liệu ghép nhóm, mỗi lớp có dạng <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"[a_i; a_{i&#x2B;1})\"></span>. Giá trị đại diện <span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i\"></span> được tính như thế nào?</p>\n",
   "questionType": "SINGLE_CHOICE",
   "points": 1.0,
   "displayOrder": 1,
   "options": [
    {
     "id": "7f35bbd8-9d2a-41d7-b1fc-9942f5405e05",
     "optionMarkdown": "$c_i=a_i+a_{i+1}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i=a_i&#x2B;a_{i&#x2B;1}\"></span></p>\n",
