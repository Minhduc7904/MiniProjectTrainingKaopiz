                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created\", function () { pm.response.to.have.status(201); });",
                  "const payload = pm.response.json();",
                  "if (payload && payload.data && payload.data.id) {",
                  "  pm.collectionVariables.set(\"mediaId\", payload.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
