     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"M_o=a_j&#x2B;\\\\dfrac{m_j}{m_{j-1}&#x2B;m_{j&#x2B;1}}\\\\cdot (a_{j&#x2B;1}-a_j)\"></span></p>\n",
     "isCorrect": false,
