# Copy from .env then replace all five database names and connection strings with these seed targets.
# Keep RabbitMQ, MinIO and other infrastructure settings identical to .env.
COURSE_DB_NAME=lms_course_seed_db
STUDENT_DB_NAME=lms_student_seed_db
MEDIA_DB_NAME=lms_media_seed_db
NOTIFICATION_DB_NAME=lms_notification_seed_db
SCHEDULER_DB_NAME=lms_scheduler_seed_db

# Docker connection strings must use mysql; local migration/scaffold strings use localhost.
# Replace only the Database= segment in the corresponding values from .env.
COURSE_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_course_seed_db;User ID=replace-with-course-db-user;Password=replace-with-a-local-course-password;SslMode=None;AllowPublicKeyRetrieval=True"
STUDENT_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_student_seed_db;User ID=replace-with-student-db-user;Password=replace-with-a-local-student-password;SslMode=None;AllowPublicKeyRetrieval=True"
MEDIA_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_media_seed_db;User ID=replace-with-media-db-user;Password=replace-with-a-local-media-password;SslMode=None;AllowPublicKeyRetrieval=True"
NOTIFICATION_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_notification_seed_db;User ID=replace-with-notification-db-user;Password=replace-with-a-local-notification-password;SslMode=None;AllowPublicKeyRetrieval=True"
SCHEDULER_DB_CONNECTION_STRING="Server=mysql;Port=3306;Database=lms_scheduler_seed_db;User ID=replace-with-scheduler-db-user;Password=replace-with-a-local-scheduler-password;SslMode=None;AllowPublicKeyRetrieval=True"
