    },
    {
     "id": "18b453cb-6279-44af-b4b4-712d58e3e05e",
     "optionMarkdown": "$c_i=\\\\dfrac{a_i+a_{i+1}}{2}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i=\\\\dfrac{a_i&#x2B;a_{i&#x2B;1}}{2}\"></span></p>\n",
     "isCorrect": true,
     "displayOrder": 2
    },
    {
     "id": "827111c2-c46f-4183-af02-96197458a24e",
     "optionMarkdown": "$c_i=\\\\dfrac{a_{i+1}-a_i}{2}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i=\\\\dfrac{a_{i&#x2B;1}-a_i}{2}\"></span></p>\n",
     "isCorrect": false,
     "displayOrder": 3
    },
    {
     "id": "f6ba5a9e-2f14-4290-904a-26d81786c0b2",
     "optionMarkdown": "$c_i=\\\\dfrac{a_i}{a_{i+1}}$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i=\\\\dfrac{a_i}{a_{i&#x2B;1}}\"></span></p>\n",
     "isCorrect": false,
     "displayOrder": 4
    }
   ]
