     "optionMarkdown": "$c_i = a_{i+1}-a_i$",
     "optionHtml": "<p><span class=\"course-math\" data-math-display=\"inline\" data-math-tex=\"c_i = a_{i&#x2B;1}-a_i\"></span></p>\n",
