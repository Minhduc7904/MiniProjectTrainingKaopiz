      "item": [
        {
          "name": "GET Students",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"OK with offset pagination\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const payload = pm.response.json();",
                  "  pm.expect(payload.data).to.be.an(\"array\");",
                  "  pm.expect(payload.meta.traceId).to.be.a(\"string\");",
                  "  pm.expect(payload.meta.pagination.type).to.eql(\"offset\");",
                  "  pm.expect(payload.meta.pagination.page).to.eql(Number(pm.collectionVariables.get(\"studentPage\")));",
                  "  pm.expect(payload.meta.pagination.pageSize).to.eql(Number(pm.collectionVariables.get(\"studentPageSize\")));",
                  "  pm.expect(payload.meta.pagination.totalItems).to.be.a(\"number\");",
                  "  pm.expect(payload.meta.pagination.totalPages).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "{{$guid}}",
                "type": "text"
              }
